# Copy to .env and export before starting (NodeDesk does not read .env itself),
# or set these in your service manager.

# Listen address. 127.0.0.1 = this machine only.
NODEDESK_ADDR=127.0.0.1:8420

# Where the SQLite database lives.
NODEDESK_DATA_DIR=/var/lib/nodedesk

# Creates the admin account on first start. Remove it afterwards if you like.
NODEDESK_ADMIN_PASSWORD=change-me-please

# First-start seed for authorised file folders: Name=/path,Name2=/path2
# NODEDESK_FILE_ROOTS=Home=/home/me,Media=/mnt/media

# Docker endpoint, if not the default socket.
# NODEDESK_DOCKER_HOST=unix:///var/run/docker.sock

# NODEDESK_LOG_LEVEL=info
